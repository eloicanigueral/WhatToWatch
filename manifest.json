{
    "manifest_version": 3,
    "name": "WhatToWatch",
    "version": "1.0",
    "description": "WtW picks a random video from your Youtube WatchLater playlist or current playlist.",

    "action": {
        "default_popup": "popup/popup.html",
        "default_icon": "icons/icons.png"
    },

    "permissions": ["activeTab", "storage", "scripting"],
    "host_permissions": ["*://*.youtube.com/*"]
}


